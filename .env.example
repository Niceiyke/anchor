# Control plane admin login (change these!)
ANCHOR_ADMIN_USER=admin
ANCHOR_ADMIN_PASS=changeme

# Public domain for the dashboard (used by the bundled Caddy).
# Use "localhost" or ":80" for local testing without TLS.
ANCHOR_DOMAIN=anchor.example.com

# Encryption key for secrets at rest (GitHub App private key, tokens).
# Generate with:  openssl rand -hex 32
# If left blank, a key file is auto-created in the data volume. Setting it here
# keeps the key separate from the data — recommended. Keep it STABLE; changing
# it means re-connecting GitHub.
ANCHOR_SECRET_KEY=

# --- Local agent (only needed if you run `--profile agent` to deploy on this
#     same VPS). Generate a shared token once with:  openssl rand -hex 32
ANCHOR_LOCAL_AGENT_TOKEN=
ANCHOR_LOCAL_SERVER_NAME=this-vps
